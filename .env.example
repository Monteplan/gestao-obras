# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - GESTÃO DE OBRAS (MONTEPLAN INCORPORADORA)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & AUTH (Produção / Cloud)
# ------------------------------------------------------------------------------
# Obtenha em: https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto-supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anonima-aqui

# ------------------------------------------------------------------------------
# SUPABASE STORAGE (Armazenamento de Planilhas Originais PCO / ERP)
# ------------------------------------------------------------------------------
VITE_SUPABASE_STORAGE_BUCKET=work_imports

# ------------------------------------------------------------------------------
# MODO DE OPERAÇÃO DA APLICAÇÃO
# ------------------------------------------------------------------------------
# development | production | demonstration
VITE_APP_ENV=development

# Habilitar persistência offline via LocalStorage quando Supabase não estiver configurado
VITE_ENABLE_OFFLINE_FALLBACK=true
